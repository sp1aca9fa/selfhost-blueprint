# Copy to .env on the server (never commit .env).

# Signs sessions and encrypts secrets. 32+ random characters, e.g. `openssl rand -base64 48`.
# Keep it in a password manager: a restored database needs the same one.
AUTH_SECRET=

# The daily job pings this after full success (healthchecks.io); a missing ping raises the alarm.
HEALTHCHECK_URL=

# Admin alerts (optional): a Discord channel's webhook link, a Telegram bot.
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=

# Folders (defaults: ~/.local/share/myapp and ~/.local/state/myapp).
# MYAPP_DATA_DIR=
# MYAPP_STATE_DIR=
# MYAPP_BACKUP_DIR=

# Main PC only (ops/copy-backups.sh): where the server's backups are copied, the server's folder,
# and the analysis copy (defaults: ~/backups/myapp, .local/share/myapp/backups,
# <data folder>/analysis/myapp.db).
# MYAPP_COPY_DIR=
# MYAPP_REMOTE_BACKUP_DIR=
# MYAPP_ANALYSIS_DB=
